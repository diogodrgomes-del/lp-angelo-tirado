# Copie para .env.local no desenvolvimento. Na Vercel, cadastre em
# Settings → Environment Variables. ATENÇÃO: ao importar o repositório a
# Vercel cria estas variáveis VAZIAS — apague as vazias antes de conectar o
# banco, senão a DATABASE_URL de exemplo bate de frente com a real.

# Banco (criado pela integração Neon da Vercel — não preencher à mão lá)
# DATABASE_URL=postgresql://usuario:senha@host-pooler/banco?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://usuario:senha@host/banco?sslmode=require

# Marca
NEXT_PUBLIC_PRODUCT_NAME=Nome do Produto
APP_SLUG=produto

# Segurança — gere com: npm run gen-key   (32 bytes em base64)
# NUNCA troque depois de conectar uma integração: as credenciais deixam de abrir.
ENCRYPTION_KEY=
# 32+ caracteres aleatórios: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# JSON gerado por: npm run hash-password -- pessoa@exemplo.com
AUTH_USERS=[]
# Token do cron da Vercel (qualquer texto aleatório longo)
CRON_SECRET=

# Checkout em uso: hubla, wiapy ou kiwify (vírgula para mais de um). Só estas ganham endpoint.
CHECKOUT_PLATFORMS=hubla
# Unidade dos valores da Wiapy: "cents" (1790 = R$ 17,90) ou "decimal" (17.90).
# Confira num payload real antes. Sem isto, os webhooks ficam guardados com erro.
WIAPY_AMOUNT_UNIT=

# Meta — opcional: login com Facebook. Sem isto, use o token de System User na tela.
# META_APP_ID=
# META_APP_SECRET=
# META_API_VERSION=v24.0
